# 1. Google Gemini API Key (Bắt buộc cho các tính năng AI)
# Lấy API Key miễn phí tại Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Cấu hình cổng chạy ứng dụng (Mặc định: 3000)
PORT=3000

# 3. Supabase Cloud (Tùy chọn kết nối nâng cao trong tương lai)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
