# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables - never commit secrets
.env*
!.env.example

# media uploads & renders (keep avatars committed so members photos show on Vercel)
/public/uploads/videos/*
!/public/uploads/videos/.gitkeep
/public/renders/*
!/public/renders/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
