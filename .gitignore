node_modules/

# Next.js
.next/
out/
build/

# Deployment
.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Temporary files
temp/
tmp/
coverage/

# Generated video renders
/public/renders/*
!/public/renders/.gitkeep


# Private LTD member data
data/members.json

# Private runtime uploads
/public/uploads/

